import sys

def main():
    s = sys.stdin.readline().strip()
    a, op, b, eq, c = s[0], s[1], s[2], s[3], s[4]

    def val(ch):
        return int(ch) if ch.isdigit() else None

    A, B, C = val(a), val(b), val(c)

    if a == 'x':
        x = (C - B) if op == '+' else (C + B)
    elif b == 'x':
        x = (C - A) if op == '+' else (A - C)
    else:  # c == 'x'
        x = (A + B) if op == '+' else (A - B)

    print(x)

if __name__ == "__main__":
    main()
